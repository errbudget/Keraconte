.venv/
__pycache__/
*.pyc
.pytest_cache/
sample*.png
# Artefacts de build : sorties PyInstaller (bundle ~1 Go) et métadonnées
# générées par « pip install -e ». Jamais versionnés.
build/
dist/
*.spec.bak
*.egg-info/

# Registres de captures réelles pour scorer la détection (must-not-read).
# Volumineux et à chat NON masqué : gardés en local, jamais poussés. Ne sont
# référencés par aucun test — seul le harnais de mesure les lit. Les captures
# promues en fixtures de test sont masquées et rangées à part, sous
# tests/fixtures/dialogues/ (celles-là SONT versionnées).
#
# themes/ et echelle/ ne sont PAS ignorés en bloc : ils contiennent des fixtures
# must-read déjà versionnées et masquées. Les captures brutes qui y restent
# (déposées pour mesure, chat non masqué) ne sont simplement pas ajoutées.
tests/fixtures/hud/
tests/fixtures/combats/

# Artefacts locaux de la précompilation audio (ADR-0004). JAMAIS versionnés :
# l'échantillon porte les TEXTES EN CLAIR du jeu et le pack en porte l'audio,
# c'est-à-dire du contenu dérivé d'Ankama — le dépôt ne contient que les
# générateurs (outils/), leur sortie est un geste local du mainteneur.
echantillon-repliques.json
pack-audio/
releve-banc*.json

# Copie locale des CGU d'Ankama, déposée pour la lecture juridique de
# l'ADR-0004 (art. 13.1/13.2 : « aucune utilisation sans autorisation
# écrite »). Ce qui est versionné, c'est l'ANALYSE dans l'ADR — pas le texte.
cgu
